# Copy to infra/.env and fill in. infra/.env is gitignored.

# Your Mac's LAN IP (run: ipconfig getifaddr en0). Must be reachable from the phone/emulator.
BASE_URL=http://192.168.1.10:3000

POSTGRES_PASSWORD=change-me

# Generate each with: openssl rand -base64 32
# Back up DB_KEYS_MASTER_KEY_B64 — it cannot be recovered and encrypts the signing keys.
DB_KEYS_MASTER_KEY_B64=
JWT_SECRET=

# First admin for the dashboard (read only on first boot).
# Password: 8+ chars with upper, lower, digit and special character.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
