# Copy this file to .env.local when setting up the app.

# GitHub classic personal access token with read:packages for the Design System.
NODE_AUTH_TOKEN=

# npm run infra:bootstrap fills in these values for the local xprem server.
# Use a URL that the phone or emulator can reach.
XPREM_URL=http://192.168.1.10:3000
XPREM_APP_ID=
EOO_TOKEN=
